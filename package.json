{
  "name": "angine",
  "version": "0.1.0",
  "description": "Local dashboard for agent-reported projects, tasks, progress, and blockers",
  "type": "module",
  "bin": {
    "angine": "./dist/bin/beacon.js",
    "beacon": "./dist/bin/beacon.js"
  },
  "files": [
    "dist",
    "ui/dist",
    "docs",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "npm run build:server && npm run build:ui",
    "build:server": "tsc -p tsconfig.server.json && node scripts/mark-bin.js",
    "build:ui": "vite build --config ui/vite.config.js",
    "prepack": "npm run build",
    "test": "npm run build:server && node scripts/run-tests.js",
    "dev": "vite --config ui/vite.config.js",
    "test:release": "node scripts/verify-package.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@preact/preset-vite": "^2.0.0",
    "preact": "^10.0.0",
    "typescript": "^5.0.0",
    "vite": "^7.0.0"
  },
  "keywords": [
    "agents",
    "dashboard",
    "mcp",
    "codex",
    "claude",
    "task-tracking"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/askinjohn/angine.git"
  },
  "homepage": "https://github.com/askinjohn/angine#readme",
  "bugs": {
    "url": "https://github.com/askinjohn/angine/issues"
  }
}
